<!-- ═══════════════ EBENEZER GLOBAL CHURCH MINISTRIES ═══════════════ -->
<section id="ebenezer">
  <div class="ebenezer-bg-glow"></div>
  <div class="ebenezer-bg-cross">✝</div>

  <div class="container ebenezer-inner">

    <div class="ebenezer-header reveal">
      <span class="ebenezer-badge">Our Spiritual Covering</span>
      <h2 class="display">Rooted In A<br><em>Greater Vision</em></h2>
      <p class="section-body" style="margin-top:1rem; margin-left:auto; margin-right:auto; text-align:center;">
        jesusVictorycenter is a branch of ebenezer global church ministries    </p>
    </div>

    <div class="ebenezer-card reveal" style="--d:0.1s">
      <div class="ebenezer-card-top">

        <!-- Identity -->
        <div class="ebenezer-identity">
          <div class="ebenezer-cross-icon">
            <svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="22" y="4" width="8" height="44" rx="2" fill="url(#cg1)"/>
              <rect x="6" y="16" width="40" height="8" rx="2" fill="url(#cg1)"/>
              <defs>
                <linearGradient id="cg1" x1="0" y1="0" x2="52" y2="52" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FF6B2B"/>
                  <stop offset="100%" stop-color="#E84B0C"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <p class="ebenezer-subtitle">Mother Church · Global Ministry</p>
          <h3 class="ebenezer-name">
            Ebenezer<br>
            <span>Global Church</span><br>
            Ministries
          </h3>
          <p class="ebenezer-desc">
            Ebenezer Global Church Ministries is a Spirit-filled, Word-grounded movement raising disciples and planting churches across Kenya and beyond. Their name — <em>"Thus far the Lord has helped us"</em> (1 Samuel 7:12) — echoes the faithfulness of God in every chapter of their story.
          </p>
          <a href="#" class="ebenezer-link-btn">Visit Ebenezer Global →</a>
        </div>

        <!-- Pillars -->
        <div class="ebenezer-pillars">
          <div class="pillar-item">
            <span class="pillar-num">I</span>
            <div class="pillar-text">
              <h4>Apostolic Foundation</h4>
              <p>Grounded in the apostolic mandate to make disciples of all nations — the Great Commission at the heart of everything they do.</p>
            </div>
          </div>
          <div class="pillar-item">
            <span class="pillar-num">II</span>
            <div class="pillar-text">
              <h4>Church Planting</h4>
              <p>A multiplying vision — raising daughter churches like Jesus Victory Center to carry the light of the Gospel into every community.</p>
            </div>
          </div>
          <div class="pillar-item">
            <span class="pillar-num">III</span>
            <div class="pillar-text">
              <h4>Spirit &amp; Word</h4>
              <p>A ministry that honours both the power of the Holy Spirit and the authority of the Word — signs, wonders, and sound teaching.</p>
            </div>
          </div>
          <div class="pillar-item">
            <span class="pillar-num">IV</span>
            <div class="pillar-text">
              <h4>Kingdom Community</h4>
              <p>Ebenezer builds a family — connecting believers across the globe in prayer, fellowship, and a shared pursuit of God's presence.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Stats bar -->
      <div class="ebenezer-stats-bar">
        <div class="ebs-stat">
          <span class="ebs-num">Global</span>
          <span class="ebs-label">Reach &amp; Vision</span>
        </div>
        <div class="ebs-stat">
          <span class="ebs-num">JVC</span>
